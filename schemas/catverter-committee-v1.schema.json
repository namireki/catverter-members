{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:com.namirekistudio.catverter:schema:committee:v1",
  "$comment": "Copyright 2026 Namireki Studio. Licensed under Apache-2.0. Deprecated compatibility schema; use the member catalog schemas.",
  "title": "Catverter committee roster v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "documentType", "schemaVersion", "version", "updatedAt",
    "committee", "members"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentType": { "const": "catverter-committee" },
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "committee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "statuteTitle", "statute"],
      "properties": {
        "title": { "$ref": "#/$defs/localized" },
        "description": { "$ref": "#/$defs/localized" },
        "statuteTitle": { "$ref": "#/$defs/localized" },
        "statute": { "$ref": "#/$defs/localized" }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "localized": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "type": "string", "minLength": 2 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "biography", "accentColor", "imageUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/localized" },
        "biography": { "$ref": "#/$defs/localized" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "imageUrl": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "uri", "pattern": "^https://" }
          ]
        }
      }
    }
  }
}
