{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/namireki/catverter-members/main/schemas/catverter-patreon-members-v1.schema.json",
  "$comment": "Copyright 2026 Namireki Studio. Licensed under Apache-2.0.",
  "title": "Catverter Patreon member catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "documentType",
    "schemaVersion",
    "catalogType",
    "trust",
    "version",
    "updatedAt",
    "license",
    "copyright",
    "title",
    "description",
    "members"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/catverter-patreon-members-v1.schema.json"
    },
    "documentType": {
      "const": "catverter-member-catalog"
    },
    "schemaVersion": {
      "const": 1
    },
    "catalogType": {
      "const": "patreon"
    },
    "trust": {
      "const": "member-submitted"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "license": {
      "const": "Apache-2.0"
    },
    "copyright": {
      "const": "Copyright 2026 Namireki Studio"
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localized": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberType",
        "catName",
        "position",
        "photo"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "memberType": {
          "const": "patreon"
        },
        "premiumSortOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "catName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "position": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/localized"
            },
            {
              "additionalProperties": {
                "maxLength": 280
              }
            }
          ]
        },
        "photo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/photo"
            }
          ]
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "sha256",
        "byteLength",
        "rights"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/photos/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:png|jpe?g|webp)$"
        },
        "mediaType": {
          "enum": ["image/png", "image/jpeg", "image/webp"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "license",
        "permissionPath",
        "permissionSha256",
        "memberConsent"
      ],
      "properties": {
        "basis": {
          "enum": ["license", "documented-permission"]
        },
        "license": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "permissionPath": {
          "type": ["string", "null"],
          "pattern": "^permissions/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "permissionSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "memberConsent": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "license"
              }
            }
          },
          "then": {
            "properties": {
              "license": {
                "type": "string"
              },
              "permissionPath": {
                "type": "null"
              },
              "permissionSha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "documented-permission"
              }
            }
          },
          "then": {
            "properties": {
              "license": {
                "type": "null"
              },
              "permissionPath": {
                "type": "string"
              },
              "permissionSha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
