{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/namireki/catverter-members/main/schemas/catverter-members-catalog-v1.schema.json",
  "title": "Catverter members catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "documentType",
    "schemaVersion",
    "catalogId",
    "classification",
    "trust",
    "version",
    "updatedAt",
    "provenance",
    "members"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/catverter-members-catalog-v1.schema.json"
    },
    "documentType": {
      "const": "catverter-member-catalog"
    },
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "enum": [
        "standard-committee",
        "patreon-members"
      ]
    },
    "classification": {
      "enum": [
        "standard-committee",
        "patreon-member"
      ]
    },
    "trust": {
      "enum": [
        "official",
        "patreon-consented"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "provenance": {
      "oneOf": [
        {
          "$ref": "#/$defs/standardProvenance"
        },
        {
          "$ref": "#/$defs/patreonProvenance"
        }
      ]
    },
    "committee": {
      "$ref": "#/$defs/committee"
    },
    "members": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/standardMember"
          },
          {
            "$ref": "#/$defs/patreonMember"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "standard-committee"
          }
        }
      },
      "then": {
        "required": [
          "committee"
        ],
        "properties": {
          "catalogId": {
            "const": "standard-committee"
          },
          "trust": {
            "const": "official"
          },
          "provenance": {
            "$ref": "#/$defs/standardProvenance"
          },
          "committee": {
            "$ref": "#/$defs/committee"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/standardMember"
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "committee"
          ]
        },
        "properties": {
          "catalogId": {
            "const": "patreon-members"
          },
          "trust": {
            "const": "patreon-consented"
          },
          "provenance": {
            "$ref": "#/$defs/patreonProvenance"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/patreonMember"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z][a-z0-9]{1,7})?$"
      }
    },
    "standardProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "documentVersion",
        "updatedAt",
        "sourceLicense"
      ],
      "properties": {
        "repository": {
          "const": "namireki/CatverterV2"
        },
        "commit": {
          "const": "a028e772b3dfc81e68d588a354c74294be8479be"
        },
        "path": {
          "const": "committee-repository/committee.json"
        },
        "documentVersion": {
          "const": "1.0.0"
        },
        "updatedAt": {
          "const": "2026-10-24T00:00:00Z"
        },
        "sourceLicense": {
          "const": "Apache-2.0"
        }
      }
    },
    "patreonProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "documentVersion",
        "updatedAt",
        "policyPath"
      ],
      "properties": {
        "type": {
          "const": "contribution-policy"
        },
        "documentVersion": {
          "const": "1.0.0"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "policyPath": {
          "const": "CONTRIBUTING.md"
        }
      }
    },
    "committee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "statuteTitle",
        "statute"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "statuteTitle": {
          "$ref": "#/$defs/localized"
        },
        "statute": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "memberId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byteLength",
        "mediaType",
        "rights"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/(?:standard-committee|patreon-members)/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.(?:jpe?g|png|webp)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "mediaType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      }
    },
    "rights": {
      "oneOf": [
        {
          "$ref": "#/$defs/licenseRights"
        },
        {
          "$ref": "#/$defs/permissionRights"
        }
      ]
    },
    "licenseRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyrightHolder",
        "license",
        "source"
      ],
      "properties": {
        "copyrightHolder": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permissionRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyrightHolder",
        "permissionReference"
      ],
      "properties": {
        "copyrightHolder": {
          "type": "string",
          "minLength": 1
        },
        "permissionReference": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicDisplay",
        "photoDisplay",
        "consentDate"
      ],
      "properties": {
        "publicDisplay": {
          "const": true
        },
        "photoDisplay": {
          "type": "boolean"
        },
        "consentDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "standardMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "catName",
        "committeePosition",
        "shortDescription",
        "accentColor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/memberId"
        },
        "classification": {
          "const": "standard-committee"
        },
        "catName": {
          "type": "string",
          "minLength": 1
        },
        "committeePosition": {
          "$ref": "#/$defs/localized"
        },
        "shortDescription": {
          "$ref": "#/$defs/localized"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "photo": {
          "$ref": "#/$defs/photo"
        }
      }
    },
    "patreonMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "catName",
        "committeePosition",
        "consent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/memberId"
        },
        "classification": {
          "const": "patreon-member"
        },
        "catName": {
          "type": "string",
          "minLength": 1
        },
        "committeePosition": {
          "$ref": "#/$defs/localized"
        },
        "shortDescription": {
          "$ref": "#/$defs/localized"
        },
        "consent": {
          "$ref": "#/$defs/consent"
        },
        "photo": {
          "$ref": "#/$defs/photo"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "consent"
            ],
            "properties": {
              "consent": {
                "required": [
                  "photoDisplay"
                ],
                "properties": {
                  "photoDisplay": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "photo"
            ]
          },
          "else": {
            "not": {
              "required": [
                "photo"
              ]
            }
          }
        }
      ]
    }
  }
}
